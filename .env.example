# Backend base URL (required -- the app throws at import time if this is unset).
# Android emulator -> host machine: http://10.0.2.2:8000
# Physical device -> your machine's LAN IP, e.g. http://192.168.1.20:8000
# Use https:// for anything other than local development.
EXPO_PUBLIC_API_ENDPOINT=http://10.0.2.2:8000
