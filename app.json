{
	"expo": {
		"name": "KarolaHealth",
		"slug": "karola-health",
		"version": "1.0.0",
		"orientation": "default",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "light",
		"newArchEnabled": true,
		"scheme": "karola-health",
		"splash": {
			"image": "./assets/splash-icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#2B6F71"
		},
		"updates": {
			"enabled": true,
			"fallbackToCacheTimeout": 0
		},
		"ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone for voice notes.",
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to recognize your speech for consultation notes."
      }
    },
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false,
			"permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
			"package": "com.anonymous.KarolaHealth"
		},
		"web": {
			"favicon": "./assets/favicon.png",
			"bundler": "metro"
		},
		"plugins": [
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow access to scan patient QR codes."
        }
      ],
      [
        "expo-speech-transcriber",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for voice notes.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to recognize your speech for consultation notes."
        }
      ]
    ],
		"assetBundlePatterns": ["**/*"],
		"extra": {
			"eas": {
				"projectId": "be30adb0-6145-4e61-8230-850c35795970"
			}
		}
	}
}